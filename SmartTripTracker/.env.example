# Google Maps API Key (vereist voor Routes API en Reverse Geocoding)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase configuratie (wordt ook ingesteld via google-services.json / GoogleService-Info.plist)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_project_id_here
